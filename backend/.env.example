# SQL Server connection (pyodbc). Adjust driver name to what's installed on the host.
DATABASE_URL=mssql+pyodbc://<username>:<password>@<host>:1433/<database>?driver=ODBC+Driver+18+for+SQL+Server&TrustServerCertificate=yes

# Connection pool sizing. db_pool_size + db_max_overflow is the hard cap on
# concurrent DB connections this process will open — size against your SQL
# Server's max_connections and how many uvicorn workers you run.
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=30
DB_POOL_RECYCLE_SECONDS=1800
DB_POOL_TIMEOUT_SECONDS=30

# Generate with: openssl rand -hex 32
JWT_SECRET_KEY=change-me
JWT_ALGORITHM=HS256
# 10080 = 7 days. Drives both the JWT's exp claim and the session cookie's
# max_age (see app/api/v1/auth.py::COOKIE_MAX_AGE_SECONDS) — lower this for
# a production deployment where shorter sessions matter more than
# uninterrupted testing/demo sessions.
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Comma-separated list of allowed frontend origins, no trailing slash, no wildcard.
CORS_ORIGINS=http://localhost:3000

ENVIRONMENT=development

# YouTube Data API v3 key. Get one from Google Cloud Console
# (APIs & Services -> Credentials), with the "YouTube Data API v3" enabled.
# Never commit a real key. Restrict it to that API in the Google Cloud
# Console, since it's used server-side only, unrestricted IP/referrer rules
# aren't needed the way they would be for a client-side key.
YOUTUBE_API_KEY=

# Sentiment models — real fine-tuned classifiers (not e.g. the base
# UBC-NLP/MARBERT, which has no classification head). Downloaded from
# HuggingFace on first startup and cached locally after that.
SENTIMENT_MODEL_NAME=Ammar-alhaj-ali/arabic-MARBERT-sentiment
SENTIMENT_MODEL_NAME_EN=cardiffnlp/twitter-roberta-base-sentiment-latest
MODEL_DEVICE=cpu
# 0 = use every physical CPU core (os.cpu_count()) for PyTorch's CPU
# inference — set explicitly at startup since PyTorch doesn't always
# auto-detect the full core count correctly in every environment. Set to
# a specific number to cap it instead (e.g. if this process shares the
# machine with other CPU-heavy workloads).
TORCH_NUM_THREADS=0
# Comments per local-model forward pass (see analysis_service.py's main
# sentiment loop) — bigger batches are more efficient on a multi-core CPU
# as long as they still fit comfortably in memory. Raised from 64 to 128
# based on a real local benchmark (RoBERTa-en, 16-core CPU) — throughput
# kept climbing through batch=128 before flattening out past that point.
FAST_MODE_BATCH_SIZE=128
# Max tokens per comment for the local tokenizer — YouTube comments are
# short-form, so 128 covers the overwhelming majority without truncating
# real content while cutting padding waste.
FAST_MODE_MAX_LENGTH=128
# How many FAST_MODE_BATCH_SIZE-sized batches run CONCURRENTLY instead of
# one fully finishing before the next starts — the single biggest FAST-mode
# throughput lever, confirmed empirically: torch's intra-op thread pool is
# shared across concurrent Python-level callers rather than each claiming
# private threads, so more concurrent callers keep it busier rather than
# fighting it for cores. Combined with USE_ONNX_RUNTIME below, 8 concurrent
# streams took a 16-core box from ~135 comments/sec (sequential) to
# ~330-340 comments/sec — 30,000 comments in ~90 seconds instead of ~220+.
FAST_MODE_CONCURRENT_BATCHES=8

# Routes FAST-mode MARBERT/RoBERTa inference through ONNX Runtime with
# dynamic INT8 quantization instead of plain PyTorch. Turned ON by default —
# an earlier claimed ~13x speedup did NOT reproduce under a fresh, careful
# local re-benchmark (only ~1.3x alone), but combined with
# FAST_MODE_CONCURRENT_BATCHES it's a real and necessary contributor to
# hitting a 30k-comments-under-90-seconds target (see FAST_MODE_CONCURRENT_
# BATCHES above for the measured numbers). The accuracy tradeoff is small
# and concentrated in already-borderline predictions HYBRID mode's own
# escalation would likely flag anyway — set to false if running FAST mode
# standalone (no HYBRID/SMART safety net) and that tradeoff matters more
# than the speed. Requires: pip install -r requirements-onnx-optional.txt.
# The first startup with this on exports+quantizes each model once (cached
# after that in ONNX_MODEL_CACHE_DIR) — expect a one-time delay of roughly
# a minute on that first startup only.
USE_ONNX_RUNTIME=true
ONNX_MODEL_CACHE_DIR=./onnx_models

# Base URL of the frontend — used to build the link inside password-reset
# emails/logs (see auth_service.request_password_reset), and where the
# Google OAuth callback sends the browser after signing in. Not a CORS
# setting.
FRONTEND_URL=http://localhost:3000

# This backend's own public URL — Google redirects the browser here after
# consent, to /api/v1/auth/google/callback. Change to the real public
# backend URL in production.
BACKEND_URL=http://localhost:8000

# OAuth 2.0 credentials from Google Cloud Console (APIs & Services ->
# Credentials -> Create Credentials -> OAuth client ID -> Web application).
# Add both:
#   - Authorized JavaScript origins: your frontend origin (e.g.
#     http://localhost:3000)
#   - Authorized redirect URIs: {BACKEND_URL}/api/v1/auth/google/callback
#     (e.g. http://localhost:8000/api/v1/auth/google/callback) — must match
#     exactly, scheme/host/port/path.
# Leave either empty to disable Google Sign-In — /api/v1/auth/google/login
# redirects with ?error=google_not_configured rather than attempting an
# OAuth exchange it can't complete. Both are required: unlike a client-side
# "Sign in with Google" button (ID token only), this is the Authorization
# Code flow, so the secret is needed to exchange the code for tokens
# server-to-server.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# SMART-mode LLM providers (see app/ai/providers/openai_provider.py,
# gemini_provider.py). Both optional and independent — set either or both.
# With neither set, every SMART/HYBRID-mode feature (LLM sentiment
# escalation, Executive Summary, Audience Analysis) degrades gracefully:
# a clear "unavailable" API response, never a 500, and FAST-mode analysis
# is completely unaffected. If both are set, whichever provider is queried
# first for a given request uses the configured one — see
# provider_registry.resolve_provider's is_available() preference.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
# gemini-1.5-flash is fully retired (404s on generateContent). The whole
# 2.5 tier also rejects new API keys/projects ("no longer available to
# new users") — verified live, not just from docs. gemini-3.1-flash-lite
# is the current low-cost/low-latency default that works with a new key;
# use gemini-3.5-flash for stronger summary/analysis quality.
GEMINI_MODEL=gemini-3.1-flash-lite

# HYBRID mode runs FAST (MARBERT/RoBERTa) first, then escalates only the
# comments that trip one of these triggers to a SMART (LLM) provider —
# see app/ai/pipelines/analysis_pipeline.py::_run_hybrid. With no LLM key
# configured, HYBRID mode silently behaves like FAST mode (escalation is
# attempted, fails gracefully, and the FAST result is kept).
HYBRID_ESCALATION_CONFIDENCE_THRESHOLD=0.65
HYBRID_ESCALATE_ON_SARCASM=true
HYBRID_ESCALATE_ON_MIXED_LANGUAGE=true
HYBRID_ESCALATE_ON_HEAVY_EMOJI=true
# How HYBRID mode picks a final label once both FAST and SMART ran:
# highest_confidence | llm_priority | weighted_ensemble
HYBRID_DECISION_POLICY=highest_confidence

# How many comments go into ONE SMART-mode classification prompt (sentiment
# escalation, complaint/suggestion extraction) — see
# app/ai/providers/_batch_comment_classifier.py. Raised from 30 to 400
# ("High-Volume JSON Chunking") — far fewer requests on a large HYBRID job,
# which is what actually reduces rate-limit exposure. Made safe by dropping
# the per-item "reasoning" sentence from the batch response shape (see
# batch_sentiment.py) — without it, 400 compact objects still fit
# comfortably under every provider's max-output-tokens ceiling; with it,
# 400 items risked truncated, unparseable responses. The batch call's
# timeout scales with chunk size accordingly — see CALL_TIMEOUT_SECONDS in
# app/ai/providers/_retry.py.
LLM_BATCH_CLASSIFICATION_SIZE=400

# How many of the above chunks run CONCURRENTLY (asyncio.gather +
# asyncio.Semaphore) instead of one-at-a-time — the main lever for
# big-data throughput on large HYBRID/SMART jobs. 15 exceeds Gemini's
# free-tier 15-requests/minute quota on its own — a deliberate tradeoff
# for real 30k+ comment throughput. A 429 still degrades that one chunk
# to its FAST result rather than blocking the queue, bounded by
# rate_limit_retrying's own 4-attempt policy (app/ai/providers/_retry.py)
# — up to ~1-3 minutes worst case, NOT the much shorter
# CALL_TIMEOUT_SECONDS (that's for a true hang with no response at all,
# a different and much rarer failure than a clean, fast 429). Lower this
# back toward 5 on the free tier if degraded escalations become too
# frequent for your accuracy needs.
LLM_MAX_CONCURRENT_BATCHES=15

# SMART mode: every comment gets a local FAST-mode pass first, then a
# stratified sample of this size is sent to the LLM in a single batch call —
# the rest keep their FAST-mode result. Capped low enough to guarantee one
# LLM request per job regardless of dataset size.
SMART_MODE_SAMPLE_SIZE=400
# HYBRID mode: every comment gets a local FAST-mode pass, low-confidence/
# sarcastic/mixed-language comments are flagged for escalation, and a
# stratified sample of this size is drawn from that flagged pool for a
# single LLM batch call. Flagged comments beyond the cap keep their
# FAST-mode result.
HYBRID_LLM_SAMPLE_SIZE=400
# Floor on how many comments each (label, confidence, language) stratum
# contributes to a sample, even if its proportional share would be smaller —
# keeps minority opinions and rare edge cases from being sampled away.
LLM_SAMPLE_MIN_PER_STRATUM=5

# Embedding + vector search (RAG comment assistant — see app/ai/embeddings/,
# app/ai/rag/). Fully local and zero-config by default: a sentence-transformers
# model downloaded once from HuggingFace and cached (no API key), and an
# embedded Chroma vector store persisted to VECTOR_DB_PERSIST_DIR on disk
# (no server to run). Leave everything below at its default to use that —
# only set these if you want OpenAI embeddings or a hosted vector DB instead.
EMBEDDING_PROVIDER=local-minilm-multilingual
LOCAL_EMBEDDING_MODEL_NAME=paraphrase-multilingual-MiniLM-L12-v2
# Only used if EMBEDDING_PROVIDER=openai-embedding
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# chroma | qdrant | pinecone
VECTOR_DB_PROVIDER=chroma
VECTOR_DB_PERSIST_DIR=./chroma_data
# Only used if VECTOR_DB_PROVIDER=qdrant. Requires qdrant-client installed
# (pip install -r requirements-vector-optional.txt).
QDRANT_URL=
QDRANT_API_KEY=
# Only used if VECTOR_DB_PROVIDER=pinecone. Requires pinecone-client installed
# (pip install -r requirements-vector-optional.txt).
PINECONE_API_KEY=
PINECONE_ENVIRONMENT=
PINECONE_INDEX_NAME=youtube-comments

# How many comments the AI Assistant retrieves per question — raised from
# 8 to 40 so it has a genuinely representative sample to synthesize
# themes across, not just a handful of snippets.
RAG_TOP_K=40

# Per-user AI cost/abuse protection for the Universal Audience Assistant
# (see app/services/ai_usage_service.py). Every assistant turn is logged to
# the ai_usage_logs table; a new message is rejected with
# status="rate_limited" (never a 500) once either the request-count or
# token-sum limit for the current UTC day/month is reached. Tune these to
# your actual OpenAI/Gemini budget. The free-tier limits below apply to
# every account with no active Subscription row (see Stripe section below);
# _PRO variants apply once a user's subscription is active.
AI_DAILY_REQUEST_LIMIT=200
AI_DAILY_TOKEN_LIMIT=300000
AI_MONTHLY_REQUEST_LIMIT=3000
AI_MONTHLY_TOKEN_LIMIT=5000000
AI_DAILY_REQUEST_LIMIT_PRO=1000
AI_DAILY_TOKEN_LIMIT_PRO=1500000
AI_MONTHLY_REQUEST_LIMIT_PRO=15000
AI_MONTHLY_TOKEN_LIMIT_PRO=25000000

# Backing store for slowapi rate limiting (see app/core/limiter.py, the
# single shared Limiter instance every router uses). Empty = in-memory
# (memory://), correct for a single-process deployment but each worker/
# instance then enforces its own independent limit. Set to a real Redis URL
# (e.g. redis://localhost:6379/0) before running more than one worker
# process or more than one server instance, so rate limits are enforced
# globally instead of being effectively multiplied by the worker count.
# Requires the `redis` package (already in requirements.txt).
REDIS_URL=

# Sentry DSN for error monitoring. Leave blank to disable — the app runs
# fine without it, this is purely opt-in.
SENTRY_DSN=

# SMTP credentials for transactional email (currently: password-reset links,
# see app/services/email_service.py). Works with any SMTP provider — Gmail,
# SendGrid, Postmark, AWS SES, your own mail server. Leave SMTP_HOST empty
# and the reset link is logged instead of emailed (fine for local dev, NOT
# fine for production — a real user who forgets their password gets no way
# to reset it until this is set).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true

# Inbox that gets a copy of every Contact page submission (in addition to
# every message always being stored in the support_messages table regardless
# of this being set). Leave empty to only rely on the database.
SUPPORT_EMAIL=

# Stripe (see app/services/billing_service.py, app/api/v1/billing.py).
# Leave all three empty and every billing endpoint degrades gracefully —
# GET /billing/subscription always reports the free tier, and the
# checkout/portal endpoints return a clean 503 rather than a crash.
# STRIPE_SECRET_KEY: from the Stripe Dashboard -> Developers -> API keys.
# STRIPE_PRICE_ID_PRO: the Price ID (not Product ID) for your Pro plan,
#   from Dashboard -> Product catalog.
# STRIPE_WEBHOOK_SECRET: from Dashboard -> Developers -> Webhooks, after
#   pointing an endpoint at {BACKEND_URL}/api/v1/billing/webhook and
#   subscribing it to checkout.session.completed, customer.subscription.
#   updated, and customer.subscription.deleted.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_PRO=
